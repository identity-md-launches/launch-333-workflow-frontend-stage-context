{
  "name": "heartbeat-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/logic.test.ts",
    "test:browser": "node tests/browser.mjs",
    "verify": "node scripts/export.mjs --check",
    "check:rpc": "node scripts/check-rpc.mjs"
  },
  "dependencies": {"react": "19.2.0", "react-dom": "19.2.0", "viem": "2.38.5"},
  "devDependencies": {"@types/react": "19.2.2", "@types/react-dom": "19.2.2", "@vitejs/plugin-react": "5.0.4", "typescript": "5.9.3", "vite": "7.1.12", "playwright": "1.56.1", "@axe-core/playwright": "4.11.0"}
}
